def sql_str(s):
    """Escape a string for SQL single-quoted value."""
    return s.replace("'", "''")


def build_spell_insert(spell_id, name, damage, resist, target, reuse_sec,
                       is_dot=False, dot_ticks=3, is_heal=False, is_mana=False):
    """
    Build an INSERT for a single spell in spells_new.
    
    Key fields:
      effectid1 = 0 (HP change) for DD/lifetap/heal; 15 (mana) for mana restore
      effect_base_value1 = negative for damage, positive for heal/mana
      targettype = 5 (single), 6 (self only), 13 (lifetap)
      resisttype = element
      cast_time = 0 (instant — it's a proc)
      recast_time = reuse_sec * 1000
      mana = 0 (no mana cost — it's a proc)
      goodEffect = 1 for heals/mana, 0 for damage
      buffduration/formula = 0 for instant, set for DoTs
    """
    # All unused effect slots set to 254 (no effect)
    effectid_slots = ["254"] * 12
    base_slots     = ["0"] * 12
    limit_slots    = ["0"] * 12
    max_slots      = ["0"] * 12
    formula_slots  = ["100"] * 12  # 100 = no scaling

    if is_mana:
        effectid_slots[0] = "15"          # SPA 15 = Mana
        base_slots[0] = str(abs(damage))  # positive = restore mana
        good_effect = 1
        buff_dur = 0
        buff_formula = 0
    elif is_heal:
        effectid_slots[0] = "0"           # SPA 0 = HP
        base_slots[0] = str(abs(damage))  # positive = heal
        good_effect = 1
        buff_dur = 0
        buff_formula = 0
    elif is_dot:
        effectid_slots[0] = "0"
        base_slots[0] = str(-abs(damage))  # negative per tick
        max_slots[0] = str(abs(damage) * dot_ticks * 2)  # damage cap
        good_effect = 0
        buff_dur = dot_ticks  # ticks (6s each)
        buff_formula = 7     # formula 7 = fixed duration
    else:
        # DD or lifetap
        effectid_slots[0] = "0"
        base_slots[0] = str(-abs(damage))
        max_slots[0] = str(abs(damage) * 2)  # damage cap
        good_effect = 0 if target != 6 else 1
        buff_dur = 0
        buff_formula = 0

    # For lifetap (target 13), the engine handles the heal automatically

    cols = [
        "id", "name", "player_1", "teleport_zone",
        "range", "aoerange", "pushback", "pushup",
        "cast_time", "recovery_time", "recast_time",
        "buffdurationformula", "buffduration",
        "AEDuration", "mana", "effect_base_value1",
        "effect_base_value2", "effect_base_value3",
        "effect_base_value4", "effect_base_value5",
        "effect_base_value6", "effect_base_value7",
        "effect_base_value8", "effect_base_value9",
        "effect_base_value10", "effect_base_value11",
        "effect_base_value12",
        "effect_limit_value1", "effect_limit_value2",
        "effect_limit_value3", "effect_limit_value4",
        "effect_limit_value5", "effect_limit_value6",
        "effect_limit_value7", "effect_limit_value8",
        "effect_limit_value9", "effect_limit_value10",
        "effect_limit_value11", "effect_limit_value12",
        "max1", "max2", "max3", "max4",
        "max5", "max6", "max7", "max8",
        "max9", "max10", "max11", "max12",
        "icon", "memicon",
        "components1", "components2", "components3", "components4",
        "component_counts1", "component_counts2",
        "component_counts3", "component_counts4",
        "NoexpendReagent1", "NoexpendReagent2",
        "NoexpendReagent3", "NoexpendReagent4",
        "formula1", "formula2", "formula3", "formula4",
        "formula5", "formula6", "formula7", "formula8",
        "formula9", "formula10", "formula11", "formula12",
        "goodEffect", "activated", "resisttype",
        "effectid1", "effectid2", "effectid3", "effectid4",
        "effectid5", "effectid6", "effectid7", "effectid8",
        "effectid9", "effectid10", "effectid11", "effectid12",
        "targettype", "basediff", "skill",
        "zonetype", "EnvironmentType",
        "TimeOfDay", "classes1", "classes2", "classes3",
        "classes4", "classes5", "classes6", "classes7",
        "classes8", "classes9", "classes10", "classes11",
        "classes12", "classes13", "classes14", "classes15",
        "classes16",
        "CastingAnim", "TargetAnim",
        "TravelType", "SpellAffectIndex",
        "disallow_sit", "deities0", "deities1", "deities2",
        "deities3", "deities4", "deities5", "deities6",
        "deities7", "deities8", "deities9", "deities10",
        "deities11", "deities12", "deities13", "deities14",
        "deities15", "deities16",
        "npc_no_los", "field142", "field143",
        "new_icon", "spellanim", "uninterruptable",
        "ResistDiff", "dot_stacking_exempt",
        "deleteable", "RecourseLink",
        "no_partial_resist",
        "field181", "field182", "field183",
        "short_buff_box", "descnum", "typedescnum",
        "effectdescnum", "effectdescnum2",
        "npc_no_cast", "reflectable",
        "bonushate",
        "field198",
        "field199",
