#!/usr/bin/env python3
"""
Step 8 — Essence Vendors + Basic Augments
==========================================
Generates SQL for:
  - Proc spells (DD, lifetap, heal, mana restore)
  - Leveling weapon augments (Combat/Lifetap/Mana Stones)
  - Endgame stat augments (Stone of Might, etc.)
  - Endgame proc augments (Shard of Flame, etc.)
  - Vendor NPCs in Bazaar (Intro Weaponsmith, Endgame Provisioner)
  - Merchant lists with alt-currency and platinum pricing

Re-run this script at any time to regenerate the SQL.
All values are tunable from the CONFIG section below.

Usage:
    python tools/generate_augments.py
    => writes utils/sql/git/optional/step8_essence_vendors_basic_augments.sql
"""

import os, math, datetime

