<?xml version = "1.0"?>
<!-- POC: Waypoint travel window for custom DLL -->
<XML ID = "EQInterfaceDefinitionLanguage">
	<Schema xmlns = "EverQuestData" xmlns:dt = "EverQuestDataTypes"/>

	<Label item = "WP_StatusLabel">
		<ScreenID>WP_StatusLabel</ScreenID>
		<Font>2</Font>
		<RelativePosition>true</RelativePosition>
		<Location>
			<X>10</X>
			<Y>8</Y>
		</Location>
		<Size>
			<CX>400</CX>
			<CY>18</CY>
		</Size>
		<Text>Available: 0 | Total: 0</Text>
		<TextColor>
			<R>220</R>
			<G>220</G>
			<B>220</B>
		</TextColor>
		<NoWrap>true</NoWrap>
		<AlignCenter>true</AlignCenter>
		<AlignRight>false</AlignRight>
	</Label>

	<Listbox item = "WP_List">
		<ScreenID>WP_List</ScreenID>
		<DrawTemplate>WDT_Inner</DrawTemplate>
		<RelativePosition>true</RelativePosition>
		<Location>
			<X>10</X>
			<Y>30</Y>
		</Location>
		<Size>
			<CX>400</CX>
			<CY>320</CY>
		</Size>
		<TextColor>
			<R>255</R>
			<G>255</G>
			<B>255</B>
		</TextColor>
		<Columns>
			<Width>110</Width>
			<Heading>Category</Heading>
		</Columns>
		<Columns>
			<Width>230</Width>
			<Heading>Waypoint</Heading>
		</Columns>
		<Columns>
			<Width>60</Width>
			<Heading>ID</Heading>
		</Columns>
		<Style_Border>true</Style_Border>
		<Style_VScroll>true</Style_VScroll>
	</Listbox>

	<Button item = "WP_RefreshBtn">
		<ScreenID>WP_RefreshBtn</ScreenID>
		<RelativePosition>true</RelativePosition>
		<Location>
			<X>10</X>
			<Y>358</Y>
		</Location>
		<Size>
			<CX>120</CX>
			<CY>24</CY>
		</Size>
		<TooltipReference>Request waypoint list from server</TooltipReference>
		<Style_Checkbox>false</Style_Checkbox>
		<Text>Refresh</Text>
		<TextColor>
			<R>255</R>
			<G>255</G>
			<B>255</B>
		</TextColor>
		<Template>BDT_Normal</Template>
	</Button>

	<Button item = "WP_TravelBtn">
		<ScreenID>WP_TravelBtn</ScreenID>
		<RelativePosition>true</RelativePosition>
		<Location>
			<X>150</X>
			<Y>358</Y>
		</Location>
		<Size>
			<CX>120</CX>
			<CY>24</CY>
		</Size>
		<TooltipReference>Travel to selected waypoint</TooltipReference>
		<Style_Checkbox>false</Style_Checkbox>
		<Text>Travel</Text>
		<TextColor>
			<R>255</R>
			<G>255</G>
			<B>255</B>
		</TextColor>
		<Template>BDT_Normal</Template>
	</Button>

	<Button item = "WP_CloseBtn">
		<ScreenID>WP_CloseBtn</ScreenID>
		<RelativePosition>true</RelativePosition>
		<Location>
			<X>290</X>
			<Y>358</Y>
		</Location>
		<Size>
			<CX>120</CX>
			<CY>24</CY>
		</Size>
		<TooltipReference>Close this window</TooltipReference>
		<Style_Checkbox>false</Style_Checkbox>
		<Text>Close</Text>
		<TextColor>
			<R>255</R>
			<G>255</G>
			<B>255</B>
		</TextColor>
		<Template>BDT_Normal</Template>
	</Button>

	<Label item = "WP_InfoLabel">
		<ScreenID>WP_InfoLabel</ScreenID>
		<Font>1</Font>
		<RelativePosition>true</RelativePosition>
		<Location>
			<X>10</X>
			<Y>388</Y>
		</Location>
		<Size>
			<CX>400</CX>
			<CY>16</CY>
		</Size>
		<Text>Select a waypoint and click Travel</Text>
		<TextColor>
			<R>128</R>
			<G>128</G>
			<B>128</B>
		</TextColor>
		<NoWrap>true</NoWrap>
		<AlignCenter>true</AlignCenter>
		<AlignRight>false</AlignRight>
	</Label>

	<Screen item = "WaypointPOCWnd">
		<ScreenID>WaypointPOCWnd</ScreenID>
		<RelativePosition>false</RelativePosition>
		<Location>
			<X>440</X>
			<Y>180</Y>
		</Location>
		<Size>
			<CX>420</CX>
			<CY>430</CY>
		</Size>
		<Style_VScroll>false</Style_VScroll>
		<Style_HScroll>false</Style_HScroll>
		<Style_Transparent>false</Style_Transparent>
		<Text>Waypoint Travel (POC)</Text>
		<DrawTemplate>WDT_Rounded</DrawTemplate>
		<Style_Titlebar>true</Style_Titlebar>
		<Style_Closebox>true</Style_Closebox>
		<Style_Minimizebox>true</Style_Minimizebox>
		<Style_Border>true</Style_Border>
		<Style_Sizable>true</Style_Sizable>
		<Pieces>WP_StatusLabel</Pieces>
		<Pieces>WP_List</Pieces>
		<Pieces>WP_RefreshBtn</Pieces>
		<Pieces>WP_TravelBtn</Pieces>
		<Pieces>WP_CloseBtn</Pieces>
		<Pieces>WP_InfoLabel</Pieces>
	</Screen>

</XML>
